#!/usr/bin/env php
<?php

declare(strict_types=1);

const RASTER_WIDTHS = [300, 600, 1200];

$root = dirname(__DIR__);

require_once $root . '/src/Release/ReleaseRepository.php';

$releases = new ReleaseRepository(
        $root . '/badges/releases'
);

$badgeId = $argv[1] ?? null;
$increment = $argv[2] ?? 'minor';

if ($badgeId === null) {
    fail('Usage: php bin/release <badge-id> [minor|major]');
}

if (!in_array($increment, ['minor', 'major'], true)) {
    fail('Increment must be "minor" or "major".');
}

$registry = require $root . '/badges/registry.php';

if (!isset($registry[$badgeId])) {
    fail("Unknown badge: {$badgeId}");
}

$source = $root . "/badges/src/{$badgeId}.svg";

if (!is_file($source)) {
    fail("Source SVG not found: {$source}");
}

$nextVersion = $releases->next(
        $badgeId,
        $increment
);

$target = $releases->path(
        $badgeId,
        $nextVersion
);

if (is_dir($target)) {
    fail("Release already exists: {$badgeId}/{$nextVersion}");
}

if (!mkdir($target, 0775, true) && !is_dir($target)) {
    fail("Could not create release directory: {$target}");
}

echo "Releasing {$badgeId} {$nextVersion}\n";

try {
    copyOrFail(
            $source,
            "{$target}/badge.svg"
    );

    renderRasterFormats(
            $source,
            $target
    );

    echo "Created:\n";

    foreach (glob("{$target}/*") as $file) {
        echo '  ' . basename($file) . PHP_EOL;
    }

    echo PHP_EOL;
    echo "Building website...\n";

    passthru(
            escapeshellarg(PHP_BINARY)
            . ' '
            . escapeshellarg($root . '/bin/build'),
            $exitCode
    );

    if ($exitCode !== 0) {
        throw new RuntimeException(
                "Website build failed with exit code {$exitCode}."
        );
    }

    echo PHP_EOL;
    echo "Released {$badgeId} {$nextVersion} successfully.\n";
} catch (Throwable $e) {
    removeDirectory($target);

    fail(
            "Release failed: {$e->getMessage()}"
    );
}


function renderRasterFormats(
        string $source,
        string $target
): void {
    $svg = file_get_contents($source);

    if ($svg === false) {
        throw new RuntimeException(
                "Could not read source SVG."
        );
    }

    foreach (RASTER_WIDTHS as $width) {
        renderRaster(
                $svg,
                "{$target}/badge-{$width}.png",
                'png',
                $width
        );

        renderRaster(
                $svg,
                "{$target}/badge-{$width}.webp",
                'webp',
                $width
        );
    }
}


function renderRaster(
        string $svg,
        string $filename,
        string $format,
        int $width
): void {
    $image = new Imagick();

    try {
        $image->setResolution(192, 192);
        $image->setBackgroundColor(
                new ImagickPixel('transparent')
        );

        $image->readImageBlob($svg);

        $sourceWidth = $image->getImageWidth();
        $sourceHeight = $image->getImageHeight();

        if ($sourceWidth <= 0 || $sourceHeight <= 0) {
            throw new RuntimeException(
                    "Invalid source geometry: {$sourceWidth}x{$sourceHeight}"
            );
        }

        $height = (int) round(
                $width * ($sourceHeight / $sourceWidth)
        );

        $image->resizeImage(
                $width,
                $height,
                Imagick::FILTER_LANCZOS,
                1
        );

        $image->setImageFormat($format);

        if ($format === 'webp') {
            $image->setImageCompressionQuality(90);
        }

        if (!$image->writeImage($filename)) {
            throw new RuntimeException(
                    "Could not write {$filename}"
            );
        }
    } finally {
        $image->clear();
        $image->destroy();
    }
}


function copyOrFail(
        string $source,
        string $target
): void {
    if (!copy($source, $target)) {
        throw new RuntimeException(
                "Could not copy {$source} to {$target}."
        );
    }
}


function removeDirectory(string $directory): void
{
    if (!is_dir($directory)) {
        return;
    }

    foreach (
            new RecursiveIteratorIterator(
                    new RecursiveDirectoryIterator(
                            $directory,
                            FilesystemIterator::SKIP_DOTS
                    ),
                    RecursiveIteratorIterator::CHILD_FIRST
            )
            as $item
    ) {
        if ($item->isDir()) {
            rmdir($item->getPathname());
        } else {
            unlink($item->getPathname());
        }
    }

    rmdir($directory);
}


function fail(string $message): never
{
    fwrite(STDERR, $message . PHP_EOL);
    exit(1);
}