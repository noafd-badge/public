#!/usr/bin/env php
<?php

declare(strict_types=1);

$root = dirname(__DIR__);

require_once $root . '/vendor/autoload.php';

require_once $root . '/src/Helper/helper.php';

require_once $root . '/src/Release/ReleaseRepository.php';
require_once $root . '/src/Content/MarkdownRenderer.php';
require_once $root . '/src/Content/ContentLoader.php';
require_once $root . '/src/Navigation/SiteStructure.php';

$siteStructure = new SiteStructure(
        $root . '/content/navigation.yaml'
);

$mainNavigation = $siteStructure->navigation('main');
$homeNavigation = $siteStructure->navigation('home');
$footerNavigation = $siteStructure->navigation('footer');

$releases = new ReleaseRepository(
    $root . '/badges/releases'
);

$contentLoader = new ContentLoader(
        $root . '/content',
        new MarkdownRenderer(),
);

$staticContent = [
        'intro' => $contentLoader->load('home/intro'),
        'about' => $contentLoader->load('home/about'),
        'howto' => $contentLoader->load('home/howto'),
];


$cdnBaseUrl = getenv('CDN_BASE_URL');

if (!$cdnBaseUrl) {
    throw new RuntimeException(
            'CDN_BASE_URL is required.'
    );
}

$dist = "{$root}/dist";
clearDirectory($dist);
if (!is_dir($dist)) {
    mkdir($dist, 0775, true);
}


$cdnBaseUrl = rtrim($cdnBaseUrl, '/');

$registry = require "{$root}/badges/registry.php";

$badges = [];


foreach ($registry as $id => $definition) {
    $version = $releases->latest($id);

    if ($version === null) {
        // Badge ist noch Work in Progress.
        continue;
    }

    $releaseDir = $releases->path(
        $id,
        $version
    );

    if (!is_file($releaseDir . '/badge.svg')) {
        throw new RuntimeException(
            "Missing SVG for release {$id}/{$version}"
        );
    }

    $baseUrl = sprintf(
        '%s/%s/%s',
        $cdnBaseUrl,
        $id,
        $version
    );

    $svg = $baseUrl . '/badge.svg';

    $badges[] = [
        ...$definition,

        'id'      => $id,
        'version' => $version,

        'cdnSvg'  => $svg,
        'cdnPng'  => $baseUrl . '/badge-600.png',
        'cdnWebp' => $baseUrl . '/badge-600.webp',

        'embed' => sprintf(
            '<img src="%s" alt="%s">',
            $svg,
            htmlspecialchars(
                $definition['alt'],
                ENT_QUOTES
            )
        ),
    ];
}


$renderNavigation = function (
        array $items
) use (&$renderNavigation): void {
    ?>
    <ul>
        <?php foreach ($items as $item): ?>
            <li>
                <?php if ($item['href'] !== null): ?>
                    <a href="<?= htmlspecialchars($item['href']) ?>">
                        <?= htmlspecialchars($item['title']) ?>
                    </a>
                <?php else: ?>
                    <span>
                        <?= htmlspecialchars($item['title']) ?>
                    </span>
                <?php endif; ?>

                <?php if (!empty($item['children'])): ?>
                    <?php $renderNavigation($item['children']); ?>
                <?php endif; ?>
            </li>
        <?php endforeach; ?>
    </ul>
    <?php
};


ob_start();

require "{$root}/src/templates/home.php";

$content = ob_get_clean();

$title = 'NoAfD Badge – Haltung sichtbar machen';

ob_start();

$isHome = true;

require "{$root}/src/templates/layout.php";

$html = ob_get_clean();

$dist = "{$root}/dist";

if (!is_dir($dist)) {
    mkdir($dist, 0775, true);
}

file_put_contents("{$dist}/index.html", $html);


$pages = $siteStructure->pages();

foreach ($pages as $slug => $definition) {

    $page = [
        'title' => $definition['title'],
        'html' => $contentLoader->load(
            $definition['content']
        ),
    ];

    ob_start();

    require $root . '/src/templates/page.php';

    $content = ob_get_clean();

    $title = sprintf(
            '%s – NoAfD Badge',
            $definition['title']
    );

    ob_start();

    $isHome = false;

    require $root . '/src/templates/layout.php';

    $html = ob_get_clean();

    $target = $dist . '/' . $slug;

    if (!is_dir($target)) {
        mkdir($target, 0775, true);
    }

    file_put_contents(
            $target . '/index.html',
            $html
    );
}

@mkdir("{$dist}/assets/css", 0775, true);
@mkdir("{$dist}/assets/js", 0775, true);

copy(
    "{$root}/src/assets/css/main.css",
    "{$dist}/assets/css/main.css"
);

copy(
    "{$root}/src/assets/js/main.js",
    "{$dist}/assets/js/main.js"
);

echo "Site built.\n";